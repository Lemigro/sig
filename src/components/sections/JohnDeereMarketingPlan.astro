        <div class="mkt-kpi"><div class="mkt-kpi-lbl">CPL médio (custo por lead)</div><div class="mkt-kpi-val">R$ 720</div><div class="mkt-kpi-meta">Teto: R$ 900</div></div>
        <div class="mkt-kpi"><div class="mkt-kpi-lbl">Leads Wirtgen / trimestre</div><div class="mkt-kpi-val">45</div><div class="mkt-kpi-meta">Foco obras públicas</div></div>
        <div class="mkt-kpi"><div class="mkt-kpi-lbl">ROI campanhas sazonais</div><div class="mkt-kpi-val">3,2×</div><div class="mkt-kpi-meta">Jul–Set e Q1</div></div>
        <div class="mkt-kpi"><div class="mkt-kpi-lbl">NPS clientes ativos</div><div class="mkt-kpi-val">≥ 72</div><div class="mkt-kpi-meta">Pesquisa trimestral</div></div>
