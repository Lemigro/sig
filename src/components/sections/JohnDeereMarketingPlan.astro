        <div class="journey-arrow">→</div>
        <div class="journey-step"><div class="journey-n">2</div><div class="journey-t">Consideração</div><div class="journey-d">Demo em obra, visita à filial</div><div class="journey-a">Landing + formulário lead</div></div>
        <div class="journey-arrow">→</div>
        <div class="journey-step"><div class="journey-n">3</div><div class="journey-t">Proposta</div><div class="journey-d">Vendedor + CRM</div><div class="journey-a">Follow-up em 48h</div></div>
        <div class="journey-arrow">→</div>
        <div class="journey-step"><div class="journey-n">4</div><div class="journey-t">Fechamento</div><div class="journey-d">Financiamento JD / licitação</div><div class="journey-a">Kit comercial Wirtgen+JD</div></div>
        <div class="journey-arrow">→</div>
        <div class="journey-step"><div class="journey-n">5</div><div class="journey-t">Pós-venda</div><div class="journey-d">Assistência + recompra</div><div class="journey-a">NPS trimestral</div></div>
      </div>
    </div>

