        <div class="channel-row"><div class="channel-name">Marca Wirtgen <span>Campanha educativa</span></div><div class="channel-bar"><div class="channel-fill yellow" style="width:15%"></div></div><div class="channel-pct">15%</div></div>
        <div class="channel-row"><div class="channel-name">Retenção & reativação <span>Pós-queda 2023–24</span></div><div class="channel-bar"><div class="channel-fill" style="width:10%"></div></div><div class="channel-pct">10%</div></div>
